OPENAI_API_KEY=ใส่_api_key_ของคุณ
OPENAI_MODEL=gpt-4.1-mini

# Ephemeris engine
# MOSHIER = ใช้ Swiss Ephemeris library แบบไม่ต้องมีไฟล์ .se1 เหมาะกับทดสอบและ deploy ง่าย
# SWISS   = ใช้ Swiss Ephemeris data files (.se1) สำหรับ production precision สูงสุด
EPHEMERIS_MODE=MOSHIER
SWISS_EPHEMERIS_PATH=./ephe
HOUSE_SYSTEM=P
STRICT_EPHEMERIS=false
ALLOW_MOSHIER_FALLBACK=true
